<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalikos TV Hub</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0f111a;
            color: #ffffff;
            padding: 15px;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #1a1d29;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: #00ff88;
        }
        .admin-btn {
            background: #ff4757;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }
        .admin-btn:hover {
            background: #ff6b81;
        }
        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .card {
            background: #1a1d29;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #2d3250;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        .card h3 {
            font-size: 1rem;
            color: #a4b0be;
            margin-bottom: 10px;
        }
        .counter-value {
            font-size: 2rem;
            font-weight: bold;
            color: #00ff88;
        }
        .section-title {
            font-size: 1.2rem;
            margin: 20px 0 10px 0;
            color: #ffa502;
            border-right: 4px solid #ffa502;
            padding-right: 10px;
        }
        .content-box {
            background: #1a1d29;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #2d3250;
        }
        /* نافذة الإدارة المخفية */
        #adminModal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: #1a1d29;
            padding: 25px;
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
            text-align: center;
            border: 1px solid #00ff88;
        }
        .modal-content input {
            width: 100%;
            padding: 10px;
            margin: 15px 0;
            background: #0f111a;
            border: 1px solid #2d3250;
            color: white;
            border-radius: 6px;
            text-align: center;
            font-size: 1.1rem;
        }
        .modal-btns {
            display: flex;
            gap: 10px;
            justify-content: center;
        }
        .modal-btns button {
            padding: 8px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-submit { background: #00ff88; color: #0f111a; }
        .btn-cancel { background: #ff4757; color: white; }
    </style>
</head>
<body>

    <!-- رأس الصفحة -->
    <header>
        <div class="logo">Kalikos_Tv Hub</div>
        <button class="admin-btn" onclick="openAdminModal()">🔒 الإدارة</button>
    </header>

    <!-- أقسام العدادات التلقائية -->
    <div class="grid-container">
        <div class="card">
            <h3>إجمالي المشاهدات</h3>
            <div id="viewsCounter" class="counter-value">45820</div>
        </div>
        <div class="card">
            <h3>المشتركون المباشرون</h3>
            <div id="subsCounter" class="counter-value">12450</div>
        </div>
        <div class="card">
            <h3>المتكونون الآن</h3>
            <div id="onlineCounter" class="counter-value">340</div>
        </div>
    </div>

    <!-- قسم المحتوى الأساسي -->
    <div class="section-title">محتوى المنصة</div>
    <div class="content-box">
        <p>مرحباً بك في لوحة تحكم وموقع Kalikos_Tv الرسمي.</p>
        <p style="margin-top: 10px; color: #a4b0be;">جميع العدادات تعمل بشكل حي وتلقائي، ويمكنك الدخول لإعدادات الإدارة عبر زر القفل بالأعلى.</p>
    </div>

    <!-- نافذة إدخال كلمة السر للإدارة -->
    <div id="adminModal">
        <div class="modal-content">
            <h3>لوحة تحكم المشرف</h3>
            <p style="font-size: 0.9rem; color: #a4b0be; margin-top: 5px;">أدخل كلمة السر الخاصة بالمدير</p>
            <input type="password" id="adminPasswordInput" placeholder="أدخل كلمة السر...">
            <div class="modal-btns">
                <button class="btn-submit" onclick="verifyAdmin()">دخول</button>
                <button class="btn-cancel" onclick="closeAdminModal()">إلغاء</button>
            </div>
        </div>
    </div>

    <script>
        // حركة العدادات التلقائية المستمرة
        setInterval(() => {
            // زيادة المشاهدات عشوائياً بين 1 و 4
            const viewsEl = document.getElementById('viewsCounter');
            viewsEl.innerText = parseInt(viewsEl.innerText) + Math.floor(Math.random() * 4) + 1;

            // زيادة المشتركين أحياناً
            if(Math.random() > 0.6) {
                const subsEl = document.getElementById('subsCounter');
                subsEl.innerText = parseInt(subsEl.innerText) + 1;
            }

            // تذبذب عدد المتواجدين صعوداً وهبوطاً
            const onlineEl = document.getElementById('onlineCounter');
            let currentOnline = parseInt(onlineEl.innerText);
            let change = Math.floor(Math.random() * 5) - 2; // -2 إلى +2
            currentOnline = Math.max(100, currentOnline + change);
            onlineEl.innerText = currentOnline;
        }, 2000);

        // وظائف نافذة كلمة السر
        function openAdminModal() {
            document.getElementById('adminModal').style.display = 'flex';
            document.getElementById('adminPasswordInput').value = '';
        }

        function closeAdminModal() {
            document.getElementById('adminModal').style.display = 'none';
        }

        function verifyAdmin() {
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === "admin2008") {
                alert("مرحباً بك يا بطل! تم تسجيل الدخول بنجاح.");
                closeAdminModal();
                // يمكنك توجيهك للوحة التحكم الكاملة هنا لاحقاً
            } else {
                alert("كلمة المرور غير صحيحة! كلمة السر هي admin2008");
            }
        }
    </script>

</body>
</html>
